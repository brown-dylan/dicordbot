name: Daily Discord Check-In

on:
  workflow_dispatch:
    inputs:
      checkin_type:
        description: "Which check-in message should be sent?"
        required: true
        default: "morning"
        type: choice
        options:
          - morning
          - evening

  schedule:
    - cron: "5 8 * * 1-5"
      timezone: "America/New_York"
    - cron: "5 17 * * 1-5"
      timezone: "America/New_York"

jobs:
  post-checkin:
    runs-on: ubuntu-latest

    steps:
      - name: Send Discord check-in message
        env:
          DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_DAILY_WEBHOOK_URL }}
          DISCORD_ROLE_ID: ${{ secrets.DISCORD_DAILY_ROLE_ID }}
          SCHEDULE: ${{ github.event.schedule }}
          MANUAL_CHECKIN_TYPE: ${{ github.event.inputs.checkin_type }}
        run: |
          if [ "$MANUAL_CHECKIN_TYPE" = "morning" ] || [ "$SCHEDULE" = "5 8 * * 1-5" ]; then
            export MESSAGE="<@&${DISCORD_ROLE_ID}> **8:00 AM Morning Check-In**

Post your plan for today:

1. Top priorities today:
2. Client work:
3. Admin/internal work:
4. Help needed from anyone:"
          else
            export MESSAGE="<@&${DISCORD_ROLE_ID}> **5:00 PM End-of-Day Check-In**

Post your wrap-up:

1. Completed today:
2. Still open:
3. Needs follow-up tomorrow:
4. Anything someone else needs to take over:"
          fi

          python3 - <<'PY'
          import json
          import os
          import urllib.request

          webhook_url = os.environ["DISCORD_WEBHOOK_URL"]
          message = os.environ["MESSAGE"]
          role_id = os.environ["DISCORD_ROLE_ID"]

          payload = {
              "content": message,
              "allowed_mentions": {
                  "roles": [role_id]
              }
          }

          data = json.dumps(payload).encode("utf-8")

          request = urllib.request.Request(
              webhook_url,
              data=data,
              headers={"Content-Type": "application/json"},
              method="POST"
          )

          with urllib.request.urlopen(request) as response:
              print(f"Discord response status: {response.status}")
          PY
